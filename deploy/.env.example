POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=change-me-32-bytes-min
MQTT_INTERNAL_PASS=change-me
# домен сервісу: Caddy отримає на нього сертифікат, PUBLIC_URL = https://$DOMAIN, той самий серт іде в MQTT (8883)
DOMAIN=tv.example.com
# STICK_HOST=203.0.113.10          # адреса сервера в підказці для Solarman-стіка (типово — домен кабінету)
# ALERTS_URL=off            # вимкнути тривоги (типово: публічне дзеркало ubilling.net.ua)
# GA_ID=G-XXXXXXXXXX               # Google Analytics 4 (перезібрати static після зміни)
# GOOGLE_SITE_VERIFICATION=...      # мета-тег Search Console
# ALERTS_API_KEY=xxxx:yyyy         # ключ api.ukrainealarm.com (без нього — дзеркало ubilling)

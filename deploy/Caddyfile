# Старі ТБ без кореневого сертифіката Let's Encrypt: сторінка екрана доступна і по HTTP.
http://{$DOMAIN} {
    @tv path /s/* /tv /api/public/* /ws /media/*
    handle @tv {
        handle /api/public/* {
            reverse_proxy api:3000
        }
        handle /ws* {
            reverse_proxy api:3000
        }
        handle_path /media/* {
            root * /media
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        handle /tv {
            root * /srv/tv
            header X-Robots-Tag "noindex, nofollow"
            rewrite * /index.html
            file_server
        }
        handle_path /s/* {
            root * /srv/tv
            header X-Robots-Tag "noindex, nofollow"
            try_files {path} /index.html
            file_server
        }
    }
    handle {
        redir https://{$DOMAIN}{uri} permanent
    }
}

https://{$DOMAIN} {
    encode zstd gzip

    handle /api/* {
        header X-Robots-Tag "noindex, nofollow"
        reverse_proxy api:3000
    }
    handle /ws* {
        reverse_proxy api:3000
    }
    # відео фонів: range-запити і кеш з коробки
    handle_path /media/* {
        root * /media
        header Cache-Control "public, max-age=31536000, immutable"
        header X-Robots-Tag "noindex"
        file_server
    }
    # екран для ТБ: окремий легкий бандл. /tv — введення коду з пульта
    handle_path /s/* {
        root * /srv/tv
        header X-Robots-Tag "noindex, nofollow"
        try_files {path} /index.html
        file_server
    }
    handle /tv {
        root * /srv/tv
        header X-Robots-Tag "noindex, nofollow"
        rewrite * /index.html
        file_server
    }
    # кабінет
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}

# Додаткові сайти цього сервера (не частина проєкту): deploy/caddy-extra/*.caddy, у git не потрапляють.
import /etc/caddy/extra/*.caddy
